#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit: block secrets before they reach this PUBLIC repo.
#
# A credential pushed here is compromised the instant it lands -- it must be
# ROTATED, not merely deleted, because history, forks and scrapers keep it.
# That asymmetry is why this is a hook and not a habit.
#
# Detection is delegated to gitleaks (~150 maintained rules plus entropy
# analysis). An earlier version of this hook hand-rolled 8 regexes; it had two
# portability bugs within a day -- the pattern list began with "-----BEGIN" so
# grep parsed it as options and the scan silently never ran, and it used \b,
# which is a GNU extension the Mac's BSD grep does not support. Hand-rolled
# patterns also rot: every new token format needs someone to notice and edit.
# gitleaks is a static Go binary with no runtime dependencies, so there is
# nothing to be portable about.
#
# gitleaks is declared in .packages/ for both machines. It is NOT optional:
# a missing scanner fails the commit rather than quietly letting it through.
#
# Escape hatch:  git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

# Homebrew's bin is absent from a non-interactive shell's PATH on macOS, and
# git hooks run non-interactively. Without this the Mac hard-fails on every
# commit claiming gitleaks is missing when it is installed.
case ":$PATH:" in
    *:/opt/homebrew/bin:*) ;;
    *) PATH="/opt/homebrew/bin:$PATH" ;;
esac
export PATH

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not found -- refusing to commit." >&2
    echo >&2
    echo "  This repo is public, so the scan is not optional." >&2
    echo "    Arch: sudo pacman -S gitleaks" >&2
    echo "    mac : brew install gitleaks" >&2
    echo "  Both are listed in .packages/." >&2
    echo >&2
    echo "  If you are certain: git commit --no-verify" >&2
    exit 1
fi

status=0

# ── Filenames that are never safe, whatever they contain ─────────────────────
# This is NOT redundant with gitleaks. Measured 2026-08-28 against 8.30.1:
# gitleaks is content-based, and an id_rsa / .pem / .env holding innocuous text
# sails straight past it. Those are exactly the files you never want committed.
badnames=$(git diff --cached --name-only --diff-filter=ACM \
           | grep -E '(^|/)[^/]*\.(pem|key|p12|pfx|env)$|(^|/)\.env($|\.)|(^|/)id_(rsa|ed25519|ecdsa)$' || true)
if [ -n "$badnames" ]; then
    echo "pre-commit: refusing -- these filenames are never safe in a public repo:" >&2
    printf '  %s\n' $badnames >&2
    status=1
fi

# ── Content ──────────────────────────────────────────────────────────────────
# `git --staged` is the pre-commit form in gitleaks 8.30. The older
# `gitleaks protect` was REMOVED in 8.x -- do not "restore" it.
if ! gitleaks git --staged --redact --no-banner; then
    echo >&2
    echo "pre-commit: gitleaks found secrets in the staged changes (above)." >&2
    echo "  Do NOT just unstage. If it is real, ROTATE the credential." >&2
    status=1
fi

exit $status
