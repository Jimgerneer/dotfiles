#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# pre-commit: refuse to commit secret-shaped content.
#
# This repo is PUBLIC. A credential pushed here is compromised the instant it
# lands -- it must be ROTATED, not merely deleted, because history, forks and
# scrapers keep it. That asymmetry is why this is a hook and not a habit.
#
# Deliberately dependency-free: gitleaks is not installed on tinos or the Mac,
# and a hook that only works where a tool happens to be present is a hook you
# cannot rely on. If you later `brew/pacman install gitleaks`, run it in CI or
# by hand -- this stays as the always-there floor.
#
# Versioned via core.hooksPath = .githooks, so it applies on every machine that
# clones this repo. chezmoi ignores dot-prefixed entries in the source dir, so
# this directory is git state only and is never deployed anywhere.
#
# Escape hatch:  git commit --no-verify
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

status=0

# ── 1. Files that should never be committed at all, whatever they contain ────
badnames=$(printf '%s\n' "$staged" | grep -E '(^|/)[^/]*\.(pem|key|p12|pfx|env)$|(^|/)\.env($|\.)|(^|/)id_(rsa|ed25519|ecdsa)$' || true)
if [ -n "$badnames" ]; then
    echo "pre-commit: refusing -- these filenames are never safe in a public repo:" >&2
    printf '  %s\n' $badnames >&2
    status=1
fi

# ── 2. Secret-shaped ADDED lines ─────────────────────────────────────────────
# Added lines only: pre-existing text is not this hook's business, and scanning
# whole files would fire on documentation that merely mentions these words.
patterns='-----BEGIN [A-Z ]*PRIVATE KEY-----'
patterns+='|gh[pousr]_[A-Za-z0-9]{16,}'
patterns+='|github_pat_[A-Za-z0-9_]{20,}'
patterns+='|xox[baprs]-[A-Za-z0-9-]{10,}'
patterns+='|AKIA[0-9A-Z]{16}'
patterns+='|sk-(ant-)?[A-Za-z0-9_-]{20,}'
patterns+='|glpat-[A-Za-z0-9_-]{16,}'
patterns+='|AIza[0-9A-Za-z_-]{30,}'
# NB: no \b anywhere -- that is a GNU grep extension and the Mac has BSD grep.
# The token prefixes (ghp_, AKIA, xox, sk-, glpat-, AIza) are distinctive enough.
# Generic assignment: KEY = "longvalue". Requires a real literal immediately
# after the operator, so `api_key\s*=\s*` inside a regex string does not match.
patterns+='|(api[_-]?key|apikey|secret|passwd|password|token|bearer)[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9/+_-]{16,}'

hits=$(git diff --cached --unified=0 -- . \
       | grep -E '^\+' | grep -vE '^\+\+\+' \
       | grep -inE -e "$patterns" || true)   # -e: $patterns starts with "-----BEGIN"

if [ -n "$hits" ]; then
    echo "pre-commit: refusing -- secret-shaped content in staged changes:" >&2
    printf '%s\n' "$hits" | head -20 | sed 's/^/  /' >&2
    echo >&2
    echo "  If this is a false positive: git commit --no-verify" >&2
    echo "  If it is real: do NOT just unstage it. Rotate the credential." >&2
    status=1
fi

exit $status
