#!/usr/bin/env bash
# Start / stop the work Mac's side of a session: the Deskflow CLIENT, and a
# caffeinate that stops the Mac sleeping while we are using it.
#
# Called by `work --start` / `work --end`, and by deskflow-server.service's
# ExecStopPost so logout, reboot and shutdown tear the Mac down too. That last
# path is why this is a script rather than inline in the unit.
set -uo pipefail

# Do NOT use `set -e`. Every failure here is non-fatal by design -- a Mac that
# is asleep or off the LAN has nothing to stop, and that must not fail the
# systemd unit or abort `work --end` half way through.

: "${SSH_AUTH_SOCK:=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket}"
export SSH_AUTH_SOCK

# ⚠️ THE MAC'S LOGIN SHELL IS FISH (verified 2026-08-27). `ssh mac '<string>'`
# is parsed by fish, not bash, so `( cmd & )` is read as a COMMAND SUBSTITUTION
# and fails with "command substitutions not allowed here". Anything beyond a
# single simple command must therefore be piped to `bash -s` on stdin, which
# works regardless of the remote login shell. Do not "simplify" this back into
# a quoted command string.
remote() { ssh -o BatchMode=yes -o ConnectTimeout=5 mac bash -s; }

# Why this exists: on 2026-09-08 the Mac's DHCP lease moved from .26 to .2 and
# every failure above printed "asleep? off the LAN?" -- which is wrong, and
# sent the search at the Mac instead of at ~/.ssh/config. The three questions
# below are the ones that actually separate the causes, in order.
mac_diagnose() {
    # `ssh -G` resolves the config exactly as ssh will, so this reports the
    # HostName really in force rather than one assumed from reading the file.
    local host addr
    host=$(ssh -G mac 2>/dev/null | awk '/^hostname /{print $2}')
    echo "  ── why it failed ──────────────────────────────" >&2
    echo "  ssh config points 'mac' at: ${host:-<unset>}" >&2

    if [ -z "$host" ]; then
        echo "  ✗ no Host mac block in ~/.ssh/config." >&2
        return
    fi

    # A literal IP has nothing to resolve; a name might simply not be answered.
    if printf '%s' "$host" | grep -qE '^[0-9]+(\.[0-9]+){3}$'; then
        addr="$host"
        echo "  ⚠️  that is a hardcoded IP. Both machines are on DHCP, so a" >&2
        echo "      moved lease looks exactly like a Mac that is switched off." >&2
        echo "      Prefer the mDNS name:  HostName Jims-MacBook-Air.local" >&2
    else
        addr=$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR==1{print $1}')
        if [ -z "$addr" ]; then
            echo "  ✗ '$host' does not resolve." >&2
            case "$host" in
              *.local)
                echo "    .local is mDNS, served by avahi-daemon on tinos:" >&2
                echo "      systemctl is-active avahi-daemon   (currently: $(systemctl is-active avahi-daemon 2>/dev/null))" >&2
                echo "    A sleeping Mac also stops answering mDNS -- open the lid and retry." >&2
                ;;
            esac
            return
        fi
        echo "  ✓ resolves to $addr" >&2
    fi

    # Port 22 open is the line between "not on the network" and "ssh refused
    # us" -- the two get conflated by ssh's own error text.
    #
    # ⚠️ Deliberately NOT nc: it is not installed on tinos (checked 2026-09-08,
    # no openbsd-netcat, no nmap), so an `nc`-based probe silently fell to the
    # "nothing listening" branch and printed the same kind of wrong answer this
    # function exists to stop. bash's /dev/tcp needs nothing installed. The
    # `timeout` is required -- a filtered port makes the connect hang, not fail.
    if timeout 3 bash -c "exec 3<>/dev/tcp/$addr/22" 2>/dev/null; then
        echo "  ✓ $addr:22 is open -- the network is fine" >&2
        echo "  ✗ so this is ssh itself. Full error:" >&2
        ssh -o BatchMode=yes -o ConnectTimeout=5 mac true 2>&1 | sed 's/^/      /' >&2
        echo "    If it mentions permission/publickey: ssh-add ~/.ssh/keys/id_ed25519_mac" >&2
        echo "    If it mentions host key: the Mac was reinstalled, or that IP" >&2
        echo "    now belongs to a different machine." >&2
    else
        echo "  ✗ nothing listening on $addr:22." >&2
        echo "    Either the Mac is asleep/off, or Remote Login is off" >&2
        echo "    (System Settings > General > Sharing > Remote Login)." >&2
    fi
    echo "  ───────────────────────────────────────────────" >&2
}

# Distinctive enough that the stop side matches only ours, never some other
# caffeinate the Mac runs for its own reasons. -t 43200 is a 12h cap so a
# session left open overnight stops holding the Mac awake by itself.
# Kept as a literal in each heredoc: ssh flattens its argv, so passing this
# through as an argument would lose the quoting around the spaces.

usage() { echo "usage: mac-worksession start|stop|status" >&2; exit 2; }

case "${1:-}" in
start)
    # `open -a` hands off to launchd inside the GUI session, so TCC attributes
    # Accessibility to Deskflow.app. Exec'ing deskflow-core directly over ssh
    # attributes it to sshd instead and it cannot inject input at all.
    if remote <<'REMOTE'
# ⚠️ startCoreWithGui can revert to false. With it false, `open -a Deskflow`
# opens the window and never spawns deskflow-core, so you have to press Connect
# by hand -- which is the whole thing this script exists to avoid.
#
# Observed 2026-08-27: an edit stuck across one launch, then read false again.
# A later stop/start cycle did NOT revert it, so the likely culprit was a
# long-running GUI instance predating the edit writing its stale in-memory
# value out on quit -- not a rewrite on every quit as first assumed.
#
# Setting it HERE is safe and self-healing: we only reach this point with
# Deskflow stopped, which is the only moment the file can be edited without the
# app clobbering it. The permanent alternative is to tick the box once in the
# GUI's own settings, on the Mac.
CONF="$HOME/Library/Deskflow/Deskflow.conf"   # NB: not ~/.config, this is macOS
if [ -f "$CONF" ] && ! pgrep -qf 'Deskflow.app/Contents/MacOS/Deskflow'; then
    sed -i '' 's/^startCoreWithGui=false$/startCoreWithGui=true/' "$CONF"
    # One mechanism owns the clipboard and it is the SSH bridge, not Deskflow.
    sed -i '' 's/^clipboardSharing=true$/clipboardSharing=false/' "$CONF"

    # ⚠️ remoteHost is the address the CLIENT DIALS, and it was a hardcoded
    # 192.168.0.17 -- tinos's DHCP lease, not a fixed address. The Mac's own
    # lease moved on 2026-09-08 and broke `ssh mac`; tinos's can move exactly
    # the same way and would break Deskflow with no obvious symptom (the app
    # opens, and silently retries an address nobody answers).
    #
    # SSH_CONNECTION is set by sshd on the Mac and its first field is the
    # client address -- i.e. wherever tinos actually is, as measured from the
    # far end of this very connection. Nothing to resolve, nothing to cache,
    # and it cannot disagree with reality: the packets came from there.
    #
    # Safe to write here for the same reason as the two lines above -- this
    # branch only runs with Deskflow STOPPED, the one moment QSettings will
    # not clobber the file on quit.
    TINOS="${SSH_CONNECTION%% *}"
    if [ -n "$TINOS" ] && ! grep -q "^remoteHost=$TINOS:24800$" "$CONF"; then
        sed -i '' "s|^remoteHost=.*|remoteHost=$TINOS:24800|" "$CONF"
        echo "  mac: remoteHost repointed at $TINOS:24800"
    fi
fi

open -a Deskflow || exit 1
pgrep -f 'caffeinate -dis -t 43200' >/dev/null 2>&1 \
    || (nohup caffeinate -dis -t 43200 >/dev/null 2>&1 &)
REMOTE
    then
        echo "  mac: Deskflow client started, sleep inhibited (12h cap)"
    else
        echo "  mac: could not start -- the Mac did not answer." >&2
        mac_diagnose
        exit 1
    fi
    ;;
stop)
    # osascript quit is a clean Cmd-Q. The GUI owns deskflow-core as a child,
    # so quitting the app takes the client with it. Verified 2026-08-27.
    if remote <<'REMOTE'
osascript -e 'quit app "Deskflow"' >/dev/null 2>&1 || true
pkill -f 'caffeinate -dis -t 43200' >/dev/null 2>&1 || true
exit 0
REMOTE
    then
        echo "  mac: Deskflow quit, sleep re-enabled"
    else
        echo "  mac: unreachable -- nothing stopped (fine if it is asleep)"
    fi
    ;;
status)
    remote <<'REMOTE' || echo "  mac: unreachable"
if pgrep -qf 'Deskflow.app/Contents/MacOS/Deskflow'; then
    echo "  mac: Deskflow        RUNNING"
else
    echo "  mac: Deskflow        stopped"
fi
if pgrep -qf 'caffeinate -dis -t 43200'; then
    echo "  mac: sleep           INHIBITED"
else
    echo "  mac: sleep           normal"
fi
REMOTE
    ;;
*) usage ;;
esac
