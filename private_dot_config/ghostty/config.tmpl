{{- $p := index .palettes .theme -}}
# Colours come from .chezmoidata/palettes.toml, selected by `theme` in
# ~/.config/chezmoi/chezmoi.toml. Switch with the `theme` command.
# Active palette: {{ .theme }}
background = {{ $p.bg1 }}
foreground = {{ $p.fg1 }}
cursor-color = {{ $p.accent }}
selection-background = {{ $p.bg3 }}
selection-foreground = {{ $p.fg0 }}
{{ range $i, $c := $p.ansi -}}
palette = {{ $i }}={{ $c }}
{{ end }}
# ── Transparency ─────────────────────────────────────────────────────────────
# Let a little wallpaper through. Done HERE rather than with Hyprland's
# `decoration { active_opacity }` on purpose: that dims the whole window surface
# for every app matched, and hyprland.conf deliberately pins both opacities to
# 1.0 ("never dim -- this is a colour-work box"). Per-app alpha in ghostty
# leaves Resolve and everything else untouched.
#
# background-opacity-cells is the line that makes this work inside zellij.
# By default ghostty applies opacity only to the WINDOW background; any cell
# with an explicit background colour stays fully opaque. Zellij repaints its
# pane background from its theme (gruvbox-dark), so without this the terminal
# would be transparent only around the edges and solid everywhere zellij draws
# -- i.e. almost all of it. Zellij cannot fix this end: its theme spec has no
# alpha channel (zellij-org/zellij#865, open since 2021).
#
# Trade-off: alpha now applies to ALL explicit backgrounds, so selection
# highlights and nvim's colourcolumn also thin out slightly. Raise toward 1.0 if
# that reads washed out; 1.0 disables transparency entirely.
#
# Blur stays off (ghostty's default) to match `blur { enabled = false }` in
# hyprland.conf -- it costs GPU every frame during a render.
background-opacity = 0.85
background-opacity-cells = true

# Font
# font-family-bold = "PragmataPro Mono Liga Bold"
# font-family-italic = "PragmataProp Mono Liga Italic"
# font-family-bold-italic = "PragmataProp Mono Liga Bold Italic"
font-family = "PragmataPro Mono Liga"
font-size = {{ .fontSize }}

# ── Ligatures ────────────────────────────────────────────────────────────────
# There was a `font-feature = "on"` here. It did nothing: the syntax is a
# 4-char OpenType tag plus a state (`calt on`, `-liga`), and ghostty silently
# ignores settings it cannot parse. Ligatures are ON by default anyway -- you
# turn them OFF with `-calt` -- so the line was a no-op that read like a switch.
#
# The real reason ligatures looked broken at the fish prompt is below. Ghostty
# shapes ligatures only across a "run" of cells, and by default it deliberately
# BREAKS the run under the cursor so you can see individual characters while
# editing. At a shell prompt the cursor is always sitting in the text you are
# looking at, so `!=` and `->` stay unligated exactly where you type -- while
# the same glyphs render ligated in ordinary output. no-cursor stops that break.
#
# Trade-off: editing inside a ligature is less precise now, because the cursor
# no longer splits it back into separate glyphs. Drop this line to get that back.
#
# Runs also break at STYLE boundaries, and that part is NOT configurable: two
# characters with different colours never ligate. Measured with a per-character
# coloured test line -- `=>`, `!=`, `<=` split, and only the pairs that happened
# to land on the same colour survived. That is why ligatures still will not
# appear inside zellij, which restyles per cell.
font-shaping-break = no-cursor

# Mouse wheel. Ghostty's default is `precision:1,discrete:3` -- three lines per
# wheel click. On its own that is fine, but inside zellij it compounds: ghostty
# reports the scroll, zellij applies its OWN step per event, and one click jumps
# a long way. zellij exposes no scroll-step setting, so the fix belongs here.
#   discrete:1 = one line per click.  Try 2 if this now feels too slow.
#   precision  = trackpads only (GTK scroll-begin/end); a wheel never takes it.
#
# 🔴 Linux + Ghostty 1.3.x: discrete:1 is NOT one line per click here. The
# G502's hi-res wheel arrives as ~7 fractional events per detent (counted
# 2026-10-26 with a mouse-reporting probe: 6-7 SGR wheel reports per click).
# 1.3.x rounds every fractional wheel event UP to a whole tick
# (Surface.zig scrollCallback, `@max(yoff, 1)`), so each one became a line, and
# a zellij pane scrolled ~7 x its own step: almost a full screen per click.
# Upstream main makes that rounding macOS-only (unreleased as of 2026-10-26).
# So 1.3.x on Linux gets ~1/7: each event is ~0.15 line and they accumulate.
# The gate drops the workaround automatically on any non-1.3 version, where
# 0.15 would mean 0.15 lines per click. Re-test with the probe after upgrading.
{{ if and (eq .chezmoi.os "linux") (lookPath "ghostty") (contains "Ghostty 1.3." (output "ghostty" "--version")) -}}
mouse-scroll-multiplier = precision:1,discrete:0.15
{{- else -}}
mouse-scroll-multiplier = precision:1,discrete:1
{{- end }}

adjust-cursor-thickness = 3
adjust-underline-position = 3
bold-is-bright = true
link-url = true
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden

# ── SSH: carry ghostty's terminfo to remote hosts ────────────────────────────
# TERM here is `xterm-ghostty`, and no remote machine has that terminfo entry.
# Without this, every TUI over SSH -- nvim, lazygit, gh-dash, zellij -- renders
# wrong or refuses to start, and the usual "fix" people reach for is exporting
# TERM=xterm-256color, which silently throws away truecolor and styled
# underlines. This is the same class of problem kitty solved with `kitten ssh`.
#
# Ghostty ships the fix but ships it OFF. Defaults are:
#   cursor,no-sudo,title,no-ssh-env,no-ssh-terminfo,path
#
#   ssh-terminfo  installs ghostty's terminfo on the remote on first connect and
#                 caches the host, so it happens once. `ghostty +ssh-cache`
#                 inspects that cache.
#   ssh-env       fallback for hosts where installing is impossible (no tic, no
#                 write access): propagates COLORTERM and sets a sane TERM
#                 instead of leaving a broken one.
#
# `sudo` is left OFF (the default) -- it only matters for preserving terminfo
# across sudo on the remote, which is not something this setup does.
#
# NOTE: zellij passes TERM through UNCHANGED, unlike tmux, which rewrites it to
# screen-256color/tmux-256color. That is why zellij needs no terminfo dance of
# its own -- but it also means the OUTER terminal's terminfo has to exist on the
# remote, which is exactly what this setting arranges.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

{{/* fish is /usr/bin/fish on Arch and /opt/homebrew/bin/fish on macOS, so
     resolve it per machine rather than hardcoding. Omitted entirely if fish
     is not installed, in which case ghostty falls back to $SHELL. */}}
{{- if lookPath "fish" }}
command = {{ lookPath "fish" }}
{{- end }}

# Spurious PRIMARY-selection pastes: with mouse reporting on, scrolling inside
# zellij intermittently injected the primary selection into the focused pane
# (~1 in 4 wheel ticks, both directions). Measured 2026-08-28: no BTN_MIDDLE at
# evdev, so the "click" is invented above the kernel; Hyprland misc:middle_click_paste
# was already false, and no clipboard helper process was ever spawned -- so the
# paste comes from Ghostty itself, which owns the Wayland selection natively.
# Turning off mouse reporting stops the sequences that trigger it.
# Cost: no click-to-focus / mouse resize of zellij panes. Wheel scrolling still
# works, handled by Ghostty natively. Remove this line to restore.
# mouse-reporting = false   <- TOTAL fix, but costs click-to-focus in zellij.
#                              Flip back to this if copy-on-select is not enough.
# Trying the narrower mitigation instead: keep mouse reporting, but stop Ghostty
# filling PRIMARY from selections, so a spurious paste has nothing to insert.
# PARTIAL by nature: PRIMARY is system-wide, so a selection made in Firefox (or
# any other app) still lands there and can still be injected.
# copy-on-select = false   <- tried 2026-08-28, did NOTHING. Ghostty was never
#   the one copying: Claude Code implements its own mouse select-to-copy and
#   shells out to `wl-copy` + `wl-copy --primary`. Fixed with
#   CLAUDE_CODE_DISABLE_MOUSE instead, which is where the bug actually lives.
