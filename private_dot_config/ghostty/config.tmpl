{{- $p := index .palettes .theme -}}
# Colours come from .chezmoidata/palettes.toml, selected by `theme` in
# ~/.config/chezmoi/chezmoi.toml. Switch with the `theme` command.
# Active palette: {{ .theme }}
background = {{ $p.bg1 }}
foreground = {{ $p.fg1 }}
cursor-color = {{ $p.accent }}
selection-background = {{ $p.bg3 }}
selection-foreground = {{ $p.fg0 }}
{{ range $i, $c := $p.ansi -}}
palette = {{ $i }}={{ $c }}
{{ end }}
# Font
# font-family-bold = "PragmataPro Mono Liga Bold"
# font-family-italic = "PragmataProp Mono Liga Italic"
# font-family-bold-italic = "PragmataProp Mono Liga Bold Italic"
font-family = "PragmataPro Mono Liga"
font-feature = "on"
font-size = {{ .fontSize }}

# Mouse wheel. Ghostty's default is `precision:1,discrete:3` -- three lines per
# wheel click. On its own that is fine, but inside zellij it compounds: ghostty
# reports the scroll, zellij applies its OWN step per event, and one click jumps
# a long way. zellij exposes no scroll-step setting, so the fix belongs here.
#   discrete:1 = one line per click.  Try 2 if this now feels too slow.
#   precision  = trackpads / high-res wheels; left at 1, it is already smooth.
mouse-scroll-multiplier = precision:1,discrete:1

adjust-cursor-thickness = 3
adjust-underline-position = 3
bold-is-bright = true
link-url = true
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden

{{/* fish is /usr/bin/fish on Arch and /opt/homebrew/bin/fish on macOS, so
     resolve it per machine rather than hardcoding. Omitted entirely if fish
     is not installed, in which case ghostty falls back to $SHELL. */}}
{{- if lookPath "fish" }}
command = {{ lookPath "fish" }}
{{- end }}
