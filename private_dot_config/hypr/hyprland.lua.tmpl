-- Hyprland — tinos.  Lua config.
--
-- WHY LUA: Hyprland 0.56 warns "the .conf config format ... will be removed in
-- Hyprland 0.57". Migrated deliberately on 0.56, while the old format still
-- works and bspwm is still bootable from the greeter, rather than discovering
-- it during a routine `pacman -Syu`.
--
-- Colours are templated from .chezmoidata/palettes.toml (active: {{ .theme }}).
-- Keybinds mirror the old sxhkd/bspwm set so muscle memory carries.
--
-- Validate without running:  Hyprland --config ~/.config/hypr/hyprland.lua --verify-config

-- Hyprland wants colours as rgba(RRGGBBAA); the palette stores #RRGGBB.
local function col(hex) return "rgba(" .. hex:sub(2) .. "ff)" end

local accent   = col("{{ $p.accent }}")
local inactive = col("{{ $p.bg3 }}")

local terminal  = "ghostty"
local launcher  = "noctalia msg panel-toggle launcher"
local powermenu = "noctalia msg panel-toggle session"
local wallpaper = "{{ $wp }}"

------------------
---- MONITOR -----
------------------
-- Under Wayland the connector is DP-2 (kernel name), not DisplayPort-1 (X11).
--
-- 120 Hz, NOT 240. 239.76 is available and flashes within seconds -- confirmed
-- by controlled test with every other variable eliminated. See
-- ~/Documents/arch-rebuild/phase-4-desktop.md. Do not raise this.
hl.monitor({
    output   = "DP-2",
    mode     = "5120x1440@120",
    position = "0x0",
    scale    = 1,
})

-----------------------
---- ENVIRONMENT ------
-----------------------
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("MOZ_ENABLE_WAYLAND", "1")
-- No AQ_DRM_DEVICES: one GPU, and card numbering is assigned at probe time, so
-- pinning it risks a black screen on some future boot for no visible reason.

-----------------------
---- LOOK AND FEEL ----
-----------------------
hl.config({
    general = {
        gaps_in  = 7,
        gaps_out = 15,          -- matches bspwm's window_gap 15
        border_size = 2,
        col = {
            active_border   = accent,
            inactive_border = inactive,
        },
        layout = "dwindle",
        allow_tearing    = true,  -- required by the `immediate` game rule below
        resize_on_border = true,  -- grab any edge with the mouse
    },

    decoration = {
        rounding = 6,
        -- No blur, no shadows: both cost GPU every frame, and this machine's
        -- GPU has better things to do during a Resolve render.
        blur   = { enabled = false },
        shadow = { enabled = false },
        active_opacity   = 1.0,
        inactive_opacity = 1.0,   -- never dim: this is a colour-work box
    },

    animations = { enabled = true },

    dwindle = { preserve_split = true },

    -- Centred-master, the "3 column" shape: master in the middle, slaves split
    -- into a left and a right stack. Inert until something selects the master
    -- layout -- general:layout stays dwindle, and these values only describe
    -- what master looks like when a workspace rule switches to it (SUPER+T).
    master = {
        -- Centre column 2527 of 5120 after gaps, near the SUPER+G 2560 preset.
        -- Measured 2026-08-31: 0.55 (the default) gives 2782, 0.5 gives 2527.
        -- ⚠️ mfact only lands at CONFIG LOAD. Setting it via `hyprctl eval` on an
        -- already-tiled workspace does not re-tile -- the value reads back as
        -- changed while the geometry stays put. Reload to see it move.
        mfact = 0.5,
        -- Centre only once there are 2 slaves, i.e. exactly 3 windows. With one
        -- or two, center_master_fallback gives an ordinary master/stack instead
        -- of a lonely centred window with dead space beside it.
        slave_count_for_center_master = 2,
        center_master_fallback = "left",
        -- New windows join a side stack, so the centre keeps whatever is in it.
        new_status = "slave",
    },

    misc = {
        disable_hyprland_logo   = true,
        disable_splash_rendering = true,
        force_default_wallpaper = 0,
        focus_on_activate       = true,
        -- vrr = 0 is the default. Left off deliberately: this is a VA panel and
        -- always-on VRR can flicker on a mostly-static desktop. Under X11 VRR
        -- could never engage without an Xorg option; under Hyprland it can, so
        -- this matters more than it looks.
        vrr = 0,
    },

    input = {
        kb_layout    = "us",
        follow_mouse = 1,        -- bspwm had focus_follows_pointer true
        sensitivity  = 0,
        accel_profile = "flat",  -- no mouse acceleration

        -- Wheel speed: leave this at the neutral 1.0 and tune speed per app.
        --
        -- 🔴 Was 6.0 from 2026-09-13 to 2026-10-26, set to make the terminal
        -- feel faster. That made one wheel detent scroll nearly a full page in
        -- Brave. Hyprland's onMouseWheel multiplies value120 and the discrete
        -- step count by this factor, not only the smooth delta. So at 6.0 every
        -- client sees six detents per detent, and XWayland apps/games get six
        -- button-4/5 clicks. It is a global knob; do not use it to fix one app.
        --
        -- The device is fine: kernel hid-logitech-hidpp delivers 8 x 15 = 120
        -- v120 units per detent (measured 2026-08-27 with libinput debug-events).
        --
        -- If one app needs a different speed, use its own setting first, then
        -- a per-window rule. A per-device `scroll_factor` exists too.
        --
        -- ⚠️ `hyprctl keyword` CANNOT set this under a Lua config -- it answers
        -- "keyword can't work with non-legacy parsers. Use eval." Tune it live,
        -- no reload and nothing written to disk, with:
        --     hyprctl eval 'hl.config({ input = { scroll_factor = 1.0 } })'
        -- `hyprctl eval` takes arbitrary Lua and is the general escape hatch for
        -- probing this API -- far better than guessing at arg shapes.
        --
        -- The per-device line in `hyprctl devices` reads `scroll factor: -1.00`.
        -- That is the "unset, inherit the global" sentinel, NOT a negative
        -- multiplier. Do not try to "fix" it.
        scroll_factor = 1.0,
        numlock_by_default = true,
    },
})

hl.curve("snappy", { type = "bezier", points = { {0.05, 0.9}, {0.1, 1} } })
hl.animation({ leaf = "windows",    enabled = true, speed = 4, bezier = "snappy" })
hl.animation({ leaf = "fade",       enabled = true, speed = 4, bezier = "snappy" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 4, bezier = "snappy" })
hl.animation({ leaf = "border",     enabled = true, speed = 6, bezier = "snappy" })

-------------------
---- AUTOSTART ----
-------------------
hl.on("hyprland.start", function()
    hl.exec_cmd("noctalia")
    hl.exec_cmd("/usr/lib/polkit-kde-authentication-agent-1")
    hl.exec_cmd("wl-paste --watch cliphist store")
    hl.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/audio-out apply")
    -- hyprpaper's own config does not reliably apply at session start: it
    -- enumerates outputs before the target is ready, logs "Monitor ... has no
    -- target" and draws nothing, while the identical value over IPC always
    -- works. So wait for its socket, then tell it directly.
    --
    -- NOTE: the path is interpolated by the TEMPLATE ({{ "{{ $wp }}" }}), not by Lua
    -- concatenation. An earlier version wrote `' .. wallpaper .. '` inside this
    -- double-quoted Lua string, where it is not concatenation at all -- it is
    -- literal text, and there is no `wallpaper` variable in Lua scope either.
    -- hyprpaper received it verbatim and answered `bad path: ' .. wallpaper .. '`,
    -- which is silent at session start because nothing surfaces exec_cmd stderr.
end)

---------------------
---- KEYBINDINGS ----
---------------------
local mod = "SUPER"

-- launching
hl.bind(mod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mod .. " + space",  hl.dsp.exec_cmd(launcher))
hl.bind(mod .. " + X",      hl.dsp.exec_cmd(powermenu))
hl.bind(mod .. " + V",      hl.dsp.exec_cmd(terminal .. " --class=wiremix -e wiremix"))
-- Pull the work Mac's clipboard into this one, once. The PUSH direction runs
-- continuously as clip-push-mac.service; pulling is a hotkey on purpose --
-- running both as daemons feeds back on itself (copy here -> push -> Mac
-- pasteboard changes -> pull -> push...). See phase-6-remote-mac.md.
hl.bind(mod .. " + SHIFT + V", hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/clip-pull-mac"))

-- Focus-or-launch. Jump to the window if it is already open, start it if not --
-- the ergonomic of a global hotkey, which is the one real thing Brave app mode
-- gives up against a proper desktop client.
--
-- ⚠️ The class argument is a LUA PATTERN, not a regex -- `-` and `.` need `%`
-- escaping, NOT backslashes. The window_rule matches further down use regex and
-- look almost identical; they are not interchangeable.
--
-- Deliberately filtering in Lua rather than passing `{ class = ... }` to
-- hl.get_windows: the stub types that filter as a plain string and does not say
-- whether it matches literally or as a regex. Iterating is unambiguous, and the
-- window count here is tiny.
--
-- Focus targets the ADDRESS, not the class. `hl.dsp.focus({ window = "class:..." })`
-- does work (measured 2026-09-13), but an address cannot match the wrong window
-- if a second one ever shares the class.
local function focus_or_launch(class_pat, cmd)
    return function()
        for _, w in ipairs(hl.get_windows()) do
            if w.class and w.class:match(class_pat) then
                hl.dispatch(hl.dsp.focus({ window = "address:" .. w.address }))
                return
            end
        end
        hl.dispatch(hl.dsp.exec_cmd(cmd))
    end
end

-- Todoist. See the window_rule further down for why the class is this shape:
-- Chromium app mode generates it from the URL and ignores --class entirely.
-- ⚠️ N was free in every modifier combination (checked SUPER, SHIFT and CTRL
-- forms -- the SUPER+SHIFT+M/mute collision was found the hard way once).
hl.bind(mod .. " + N", focus_or_launch(
    "^brave%-app%.todoist%.com__",
    "brave --app=https://app.todoist.com --user-data-dir={{ .chezmoi.homeDir }}/.local/share/brave-todoist"))

hl.bind(mod .. " + ALT + Q", hl.dsp.exit())
hl.bind(mod .. " + SHIFT + C",
        hl.dsp.exec_cmd("noctalia msg panel-toggle clipboard"))

-- window management
hl.bind(mod .. " + W",         hl.dsp.window.close())

-- A work terminal, visibly labelled. `--title` FIXES the title: ghostty then
-- ignores the OSC title escapes zellij sends, so it reads "WORK" for the life
-- of the window instead of being overwritten by the remote session name.
-- Verified 2026-08-27 -- a deliberate `printf "\033]0;..."` could not budge it.
-- `fish -C` runs the command and THEN drops to an interactive prompt, so
-- detaching from zellij leaves a usable shell rather than closing the window.
-- WORK_TERM=1 marks this shell as one `work --end` may close. Starting a
-- session from an ordinary terminal leaves it unset, so --end never closes a
-- window it did not open.
hl.bind(mod .. " + M",         hl.dsp.exec_cmd("sh -c 'WORK_TERM=1 ghostty --title=\"WORK ▸ Mac\" -e fish -C \"work --start\"'"))
-- Deliberately NOT a toggle on SUPER+M: opening a second work terminal by
-- reflex would then silently tear the session down and drop mouse control
-- mid-task.
-- ⚠️ CTRL, not SHIFT: SUPER+SHIFT+M is already the audio mute toggle. Checking
-- only single-letter binds missed that -- grep the SHIFT and CTRL forms too.
-- No terminal to print into, so __work_end notifies as well as echoing.
hl.bind(mod .. " + CTRL + M",  hl.dsp.exec_cmd("fish -c 'work --end'"))
hl.bind(mod .. " + SHIFT + W", hl.dsp.window.kill())
hl.bind(mod .. " + F",         hl.dsp.window.fullscreen())
hl.bind(mod .. " + S",         hl.dsp.window.float({ action = "toggle" }))
-- Explicit "back to tiled", the counterpart to the centred presets below.
-- `action = "off"` SETS the state rather than flipping it, so this always lands
-- tiled no matter what the window was doing. The toggle above cannot promise
-- that: hit it on an already-tiled window and you float it instead.
hl.bind(mod .. " + SHIFT + S", hl.dsp.window.float({ action = "off" }))
hl.bind(mod .. " + P",         hl.dsp.window.pseudo())

-- focus (vim keys, as in bspwm)
hl.bind(mod .. " + H", hl.dsp.focus({ direction = "left"  }))
hl.bind(mod .. " + J", hl.dsp.focus({ direction = "down"  }))
hl.bind(mod .. " + K", hl.dsp.focus({ direction = "up"    }))
hl.bind(mod .. " + L", hl.dsp.focus({ direction = "right" }))

-- swap
hl.bind(mod .. " + SHIFT + H", hl.dsp.window.move({ direction = "left"  }))
hl.bind(mod .. " + SHIFT + J", hl.dsp.window.move({ direction = "down"  }))
hl.bind(mod .. " + SHIFT + K", hl.dsp.window.move({ direction = "up"    }))
hl.bind(mod .. " + SHIFT + L", hl.dsp.window.move({ direction = "right" }))

-- mouse: drag to move and resize. Works on any window, tiled or floating.
hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- workspaces
for i = 1, 10 do
    local key = i % 10                       -- 10 maps to key 0
    hl.bind(mod .. " + " .. key,             hl.dsp.focus({ workspace = i }))
    hl.bind(mod .. " + SHIFT + " .. key,     hl.dsp.window.move({ workspace = i }))
end

-- audio (Phase 1). locked = fires even when the session is locked, which is
-- what you want for media keys. -l 1.0 CAPS at 100%: without it wpctl boosts
-- past unity into software gain, which on the S/PDIF sink clips straight into
-- the desk speakers with no analog attenuator in the way.
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),        { locked = true, repeating = true })
-- Mute NOTIFIES. A silent mute toggle cost an evening on 2026-09-22: the sink
-- was muted at 00:18:01 while ending the work session, the machine suspended
-- nine seconds later, and it presented the next morning as "audio broken after
-- suspend". Headphones are a SEPARATE sink, so audio-out switching still worked
-- and hid the mute completely. Feedback is the fix, not a different key.
hl.bind("XF86AudioMute",        hl.dsp.exec_cmd("sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -q MUTED && notify-send -u critical -t 2000 \"🔇 Output MUTED\" || notify-send -t 1500 \"🔊 Output on\"'"), { locked = true })
hl.bind("XF86AudioMicMute",     hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),     { locked = true })
hl.bind(mod .. " + equal",      hl.dsp.exec_cmd("wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+"))
hl.bind(mod .. " + minus",      hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"))
-- SUPER+SHIFT+M (mute) REMOVED 2026-09-22. It was a duplicate of XF86AudioMute
-- sitting one slipped key from SUPER+M (start work session) and SUPER+CTRL+M
-- (end work session) -- three M binds in one cluster, and this was the only
-- silent one. Hit by accident while ending a work session; see line ~289.
-- The comment at the SUPER+CTRL+M bind predicted a BINDING collision here and
-- avoided it; the collision that actually landed was a FINGER one.
hl.bind(mod .. " + A",          hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/audio-out toggle"))
hl.bind(mod .. " + SHIFT + A",  hl.dsp.exec_cmd("{{ .chezmoi.homeDir }}/.local/bin/audio-out status"))

-- screenshots
hl.bind("Print",              hl.dsp.exec_cmd("sh -c 'grim - | wl-copy'"))
hl.bind(mod .. " + Print",    hl.dsp.exec_cmd("sh -c 'grim -g \"$(slurp)\" - | wl-copy'"))
hl.bind(mod .. " + SHIFT + P", hl.dsp.exec_cmd("hyprpicker -a"))

-- Annotate before saving. grim grabs the region, satty opens it for arrows,
-- boxes and blur, then writes the PNG *and* puts it on the clipboard.
-- --early-exit closes satty the moment it has saved, so it never lingers as a
-- stray window on the workspace.
--
-- Needs `satty` (extra). The two plain grim binds above are unaffected if it is
-- missing; only this one and the dir below depend on it.
hl.bind(mod .. " + SHIFT + Print", hl.dsp.exec_cmd("sh -c 'grim -g \"$(slurp)\" - | satty --filename - --output-filename {{ .chezmoi.homeDir }}/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png --early-exit --copy-command wl-copy'"))

-- Region straight to a dated file: no annotation step, no clipboard detour.
-- Writes to ~/Pictures/screenshots, which must exist -- grim does not create it
-- and fails silently to a keybind with no terminal to complain into.
hl.bind(mod .. " + CTRL + Print",  hl.dsp.exec_cmd("sh -c 'grim -g \"$(slurp)\" {{ .chezmoi.homeDir }}/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png'"))

-- Centred-window presets, for games that handle 32:9 badly. There is no title
-- bar to fight: Hyprland draws no server-side decorations at all.
-- 2560x1440 is a real mode the panel advertises, so a game set to it matches
-- the window exactly with no scaling.
-- ⚠️ NATIVE DISPATCHERS, NOT `hyprctl dispatch ...`.
-- Under a Lua config, hyprctl evaluates its argument AS LUA. The classic string
-- form is dead -- measured 2026-08-26 on 0.56.2:
--     $ hyprctl dispatch centerwindow
--     error: hl.dispatch: expected a dispatcher (e.g. hl.dsp.window.close())
--     $ hyprctl dispatch exec true
--     error: [string "return hl.dispatch(exec true)"]:1: ')' expected near 'true'
--
-- This function previously shelled out with exactly that classic syntax via
-- exec_cmd, so all three G binds did NOTHING and said nothing -- exec_cmd
-- surfaces no stderr. Same trap as the hyprpaper line above.
--
-- hl.bind accepts a plain function as its action, which is how three
-- dispatchers get chained. Arg shapes probed against the running compositor;
-- the stub types these as fun(...) and documents nothing:
--     float  { action = "on" | "off" | "toggle" }
--     resize { x = <w>, y = <h>, relative? = bool, window? = <sel> }
--     center {}
--     fullscreen { action = "toggle"|"set"|"unset", mode = "fullscreen"|"maximized" }
--
-- These shapes are no longer guesswork. Hyprland's own validator strings carry
-- the contract, and 0.56.2 will print it on request:
--     strings /usr/bin/Hyprland | grep -E '^hl\.window\.'
-- Every dispatcher also takes `window = "address:0x..."`, which is how the
-- behaviour below was tested without stealing focus from a running game --
-- and passing a deliberately bogus address validates ARGUMENTS ONLY, because
-- "no target" comes after the arg check:
--     hyprctl dispatch 'hl.dsp.window.fullscreen({ action = "unset",
--         mode = "fullscreen", window = "address:0xdeadbeef" })'
--
-- 🔴 `exact = true` WAS A NO-OP AND THE COMMENT HERE WAS WRONG.
-- There is no `exact` key anywhere in Hyprland; the real one is `relative`.
-- Unknown keys are silently ignored by resize -- `banana = true` also returns
-- `ok` -- so nothing complained. resize is ABSOLUTE by default, which is why
-- this worked anyway. Measured 2026-09-08; dropped rather than left as a trap.
--
-- 🔴 THE FULLSCREEN LINE IS THE POINT OF THIS FUNCTION.
-- A window in true fullscreen ignores resize and center outright: its geometry
-- is owned by the fullscreen state. Without the unset, all three G binds do
-- NOTHING on a game that took real fullscreen -- which is the second time
-- these binds have failed silently, the first being the hyprctl-syntax trap
-- above. Measured 2026-09-08 on a hidden window, same three dispatchers:
--     fullscreen -> 5120x1440 @ 0,0   resize+center changed NOTHING
--     unset      -> 2561x1440 @ 1280,0   i.e. exactly the intended centring
-- Games that run borderless/windowed (Abiotic Factor) were never fullscreen,
-- so they always worked -- which is what made this look game-specific.
-- `unset` is safe on a window that is not fullscreen: it is a set-to-off, not
-- a toggle, so it cannot fullscreen something by accident.
local function centred(w, h)
    return function()
        hl.dispatch(hl.dsp.window.fullscreen({ action = "unset", mode = "fullscreen" }))
        hl.dispatch(hl.dsp.window.float({ action = "on" }))
        hl.dispatch(hl.dsp.window.resize({ x = w, y = h }))
        hl.dispatch(hl.dsp.window.center({}))
    end
end
hl.bind(mod .. " + G",         centred(2560, 1440))
hl.bind(mod .. " + SHIFT + G", centred(3840, 1080))
hl.bind(mod .. " + CTRL + G",  centred(1920, 1080))

-- ⛑️❌ NO DESKFLOW PANIC KEY. Tried and MEASURED DEAD 2026-08-31 -- do not re-add.
--
-- Twice (2026-08-30, 2026-08-31) input vanished from BOTH machines mid-session
-- and the only way out was the power button.
--
-- MECHANISM: deskflow does not grab devices. Crossing to the Mac makes Hyprland
-- capture input through the InputCapture portal, and the ONLY way back is
-- deskflow sending a Release carrying the matching activationId:
--     activate, activationId 125, barrierId 4, x 3423, y 1445
--     New Release request: activationId: 125, cursorPosition: 2037 1438
-- If that Release never comes -- deskflow wedged, or the client socket dead --
-- Hyprland holds the capture forever and every key and mouse motion goes into
-- the libei stream instead of to the compositor. The machine is fine; both
-- lockups ended in a clean systemd-poweroff, not a hang.
--
-- Hyprland HAS a force-release for exactly this: hl.dsp.release_input_capture().
-- It was bound to SUPER+ESCAPE (as `bindl`, modmask 64, confirmed registered).
--     ❌ It does not fire while capture is active. Tested from the Mac: nothing.
-- An active capture swallows keybinds before Hyprland evaluates them, so NO
-- keybind can be the escape hatch -- not this one, not any other combination.
-- Recovery has to come from outside the input path entirely.
--
-- ❌ `heartbeat = 5000` WAS NOT THE FIX. This comment used to end by calling it
-- one. It is in ~/.config/Deskflow/deskflow-server.conf, it is verified present,
-- and the THIRD wedge happened anyway on 2026-09-18. It appears to have moved
-- the failure rather than removed it: the server now notices the dead client and
-- then wedges on the duplicate-name check instead of reaping it --
--     WARNING: a client with name "Jims-MacBook-Air.local" is already connected
--     INFO: disconnecting client "Jims-MacBook-Air.local"
-- once a second, for 13 seconds, while the capture is never released.
--
-- ✅ SOLVED 2026-09-18 -- automatically, without a keybind and without sshd.
-- ~/Code/linux-scripts/deskflow-watchdog/ (chezmoi carries symlinks only).
-- A user service follows the journal for that duplicate-client loop and, on
-- >=6 lines in 15s, calls release_input_capture OVER IPC.
--
-- ⚠️ The dispatcher was never broken -- only its KEYBOARD TRIGGER was. hyprctl
-- is an IPC socket, not an input device, so an active capture cannot swallow it.
--     hyprctl dispatch 'hl.dsp.release_input_capture()'   -> ok (verified)
-- That is what "recovery has to come from outside the input path" actually meant.
--
-- Thresholds measured, not guessed: benign reconnect bursts in the journal run
-- 1-3 lines; the wedge ran 13 consecutive seconds. Replaying the real 2026-09-18
-- journal through the detector fires exactly once, on the real event.

-- Per-workspace 3-column toggle. Unlike the centred() presets above, this
-- TILES: the middle window owns real space with gaps, nothing floats on top.
--
-- The per-workspace part rests on `layout` being a field of a workspace rule.
-- That is Lua-only -- the .conf format never had it, so the wiki's workspace
-- rule list does not mention it. It is in the stub:
--     /usr/share/hypr/stubs/hl.meta.lua  (HL.WorkspaceRuleSpec)
-- Measured on 0.56.2, 2026-08-31: issuing this rule against a workspace holding
-- three tiled windows re-tiled it to 1134 | 2782 | 1134 immediately, with no
-- `hyprctl reload`.
--
-- The full cycle is measured on 0.56.2, 2026-08-31, on a workspace holding three
-- tiled windows -- widths left | centre | right, no `hyprctl reload` at any step:
--     dwindle      1262 | 1254 | 2534
--     toggled on   1262 | 2527 | 1261     <- centred master
--     toggled off  1262 | 1254 | 2534     <- back to dwindle, exactly as before
-- So set_enabled(false) genuinely reverts; the rule does not have to be torn
-- down and there is nothing to clean up on reload.
--
-- Rules are cached per workspace id because hl.workspace_rule ADDS a rule; a
-- second call for the same workspace would stack another one rather than
-- replace it, and there would be no handle to switch the first back off.
-- Centring the focused window needs a DEFERRED call, and the obvious routes are
-- all dead ends -- measured on 0.56.2, 2026-08-31, so nobody retries them:
--
--   hl.timer(fn, { timeout = 500 })   returns nil and NEVER FIRES. Not from the
--                                     repl, not from this config at load.
--   swapwithmaster in the same tick   no-op. Enabling the rule switches the
--                                     layout ASYNCHRONOUSLY; dispatched inline
--                                     it still runs against dwindle, which has
--                                     no master to swap with.
--   doing nothing                     master does NOT adopt the focused window.
--                                     Focused the leftmost window, toggled on,
--                                     and a different window took the centre.
--
-- So the swap is shelled out with a delay. The re-tile settles in under 50ms
-- (sampled every 50ms: the first sample was already 1261,1262,2527 against
-- dwindle's 1255,1261,2534), so 150ms is comfortably clear of it.
--
-- ⚠️ The address is captured NOW and passed through, rather than letting the
-- deferred call re-read the focused window. follow_mouse = 1 means the re-tile
-- can slide a different window under a stationary cursor and steal focus --
-- observed repeatedly while testing this -- which would centre the wrong one.
--
-- No quoting gymnastics: window.address is "0x5561b201f2f0", which Lua parses
-- as a hex integer literal, so the generated call needs no inner quotes at all
-- and tonumber(w.address) compares against it directly.

-- Global ON PURPOSE: the deferred `hyprctl eval` below reaches this by name
-- from outside the config's scope, so a local would be invisible to it.
function CentreWindow(addr)
    local ws = hl.get_active_workspace()
    if not ws then return end
    local target, widest, best = nil, nil, -1
    for _, w in ipairs(hl.get_workspace_windows(ws)) do
        if not w.floating then
            if tonumber(w.address) == addr then target = w end
            -- In centred master the master column IS the widest tiled window
            -- (mfact 0.5: 2527 centre against ~1262 sides). HL.Window has no
            -- is_master field, so width is the only handle on it.
            if w.size.x > best then best, widest = w.size.x, w end
        end
    end
    if not target or not widest then return end
    -- ⚠️ Bail if it is ALREADY centred. swapwithmaster on the master window
    -- does not no-op -- it EVICTS it to a side stack. Measured: focused master
    -- at x=1297 w=2527 went to x=17 w=1262 and a slave took the centre.
    if widest.address == target.address then return end
    hl.dispatch(hl.dsp.focus({ window = target }))
    hl.dispatch(hl.dsp.layout("swapwithmaster"))
    hl.dispatch(hl.dsp.focus({ window = target }))
end

-- Also global so the behaviour can be driven and tested without synthesising a
-- keypress: `hyprctl eval 'ToggleThreeColumn()'`.
local three_col = {}
function ToggleThreeColumn()
    local ws = hl.get_active_workspace()
    if not ws then return end
    local id = tostring(ws.id)
    if three_col[id] then
        three_col[id]:set_enabled(not three_col[id]:is_enabled())
    else
        three_col[id] = hl.workspace_rule({
            workspace   = id,
            layout      = "master",
            layout_opts = { orientation = "center" },
        })
    end
    -- Only on the way ON. Toggling off just returns the workspace to dwindle,
    -- where there is no centre to move anything into.
    if not three_col[id]:is_enabled() then return end
    local win = hl.get_active_window()
    if not win or win.floating then return end
    hl.dispatch(hl.dsp.exec_cmd(
        [[sh -c "sleep 0.15; hyprctl eval ']] .. "CentreWindow(" .. win.address .. ")" .. [['"]]))
end
hl.bind(mod .. " + T", ToggleThreeColumn)

--------------------------------
---- WINDOW RULES --------------
--------------------------------
-- Never let a fullscreen app be dimmed out from under you.
hl.window_rule({ name = "idle-fullscreen", match = { class = ".*" }, idle_inhibit = "fullscreen" })

-- DaVinci Resolve: XWayland only (its launcher forces QT_QPA_PLATFORM=xcb) and
-- must never be tiled -- its floating panels break under a tiler.
hl.window_rule({ name = "resolve-float",  match = { class = "^(resolve)$" }, float = true })
hl.window_rule({ name = "resolve-border", match = { class = "^(resolve)$" }, border_size = 0 })
-- CRITICAL: hypridle measures INPUT idleness, not CPU. A three-hour render with
-- nobody at the keyboard looks exactly like an idle machine, and the 1800 s
-- suspend would kill it.
hl.window_rule({ name = "resolve-idle",   match = { class = "^(resolve)$" }, idle_inhibit = "always" })

-- Games
hl.window_rule({ name = "game-float",     match = { class = "^(steam_app_.*)$" }, float = true })
hl.window_rule({ name = "game-immediate", match = { class = "^(steam_app_.*)$" }, immediate = true })
hl.window_rule({ name = "game-border",    match = { class = "^(steam_app_.*)$" }, border_size = 0 })
hl.window_rule({ name = "game-center",    match = { class = "^(steam_app_.*)$" }, center = true })

-- Steam's own chrome should tile normally, so it is matched separately.
-- ── Star Citizen ────────────────────────────────────────────────────────
-- Not a Steam title, so it never matches ^(steam_app_.*)$ above. Classes
-- measured 2026-09-18 from a live session, not guessed:
--     starcitizen.exe    the game   XWayland, fs=2, 5120x1440
--     rsi launcher.exe   launcher   XWayland, floating, 1440x900
--     explorer.exe       "Wine System Tray", 160x20 stray
--
-- 🔴 idle_inhibit IS THE POINT OF THIS BLOCK. hypridle measures INPUT
-- idleness, and this machine locks at 600 s, blanks at 3600 s and SUSPENDS at
-- 5400 s. A long cruise with a stick in your hand and no keyboard input looks
-- exactly like an idle machine -- you would be locked out mid-flight and
-- suspended an hour later. Same trap as resolve-idle. The generic
-- idle-fullscreen rule is NOT enough to rely on here.
--
-- ⚠️ Deliberately NO `center`, unlike the game-* rules above. Those exist for
-- titles that handle 32:9 badly; SC renders 5120x1440 natively (measured), so
-- centring it would be actively wrong.
hl.window_rule({ name = "sc-float",     match = { class = "^(starcitizen\\.exe)$" }, float = true })
-- ⚠️ DISABLED 2026-09-19 pending an A/B. Inventory filter menus flicker on and
-- off. `immediate` allows tearing/immediate presentation, which is a plausible
-- cause of visible artifacts on UI overlays -- and it was added the same session
-- the symptom appeared, so it must be ruled out before blaming Wine/Wayland.
-- If the flicker persists with this off, it is the cursor-mode flip (same class
-- as the ASOP bug) and gamescope --force-grab-cursor is the next step.
-- hl.window_rule({ name = "sc-immediate", match = { class = "^(starcitizen\\.exe)$" }, immediate = true })
hl.window_rule({ name = "sc-border",    match = { class = "^(starcitizen\\.exe)$" }, border_size = 0 })
hl.window_rule({ name = "sc-idle",      match = { class = "^(starcitizen\\.exe)$" }, idle_inhibit = "always" })
-- Workspace 6 is `game` in the phase-4 layout. Not `silent`: launching it
-- should take you there, the same as the other launch binds.
hl.window_rule({ name = "sc-ws",        match = { class = "^(starcitizen\\.exe)$" }, workspace = "6" })
-- 🔴 Stop Star Citizen stealing focus. misc.focus_on_activate = true (line ~105)
-- honours activation requests, and Wine/XWayland games send them freely -- so
-- switching to TeamSpeak's workspace and clicking it yanked you straight back
-- to workspace 6, making TeamSpeak unusable mid-session. Found 2026-09-20.
-- Scoped to SC rather than turning focus_on_activate off globally, which is
-- wanted for everything else.
hl.window_rule({ name = "sc-nosteal",   match = { class = "^(starcitizen\\.exe)$" }, suppress_event = "activatefocus" })

-- The launcher floats on its own; this just keeps it out of the tiling layout
-- deterministically rather than by accident.
hl.window_rule({ name = "rsi-launcher-float", match = { class = "^(rsi launcher\\.exe)$" }, float = true })

hl.window_rule({ name = "steam-friends",  match = { title = "^(Friends List)$" },   float = true })
hl.window_rule({ name = "steam-settings", match = { title = "^(Steam Settings)$" }, float = true })

-- Picture-in-picture and dialogs
-- ── workspace routing ───────────────────────────────────────────────────
-- Workspace 3 is `notes` in the phase-4 layout. That table was written in
-- August and never implemented; these two rules are it.
--
-- Todoist DO ship official Linux builds (Snap and AppImage) -- but both sit
-- outside pacman and need hand-updating. That is exactly how the old
-- `todoist` AUR CLI rotted from 2023 until Todoist killed the API under it in
-- Feb 2026, with nothing to announce it. So: Brave in app mode instead.
-- Nothing new to maintain, native Wayland already, updates with the browser.
--
-- The packaged `todoist-wrapper` is NOT usable: its SecurityService injects a
-- CSP allowing only 'self' and https://*.todoist.com, while Todoist serves its
-- JS/CSS from todoist.b-cdn.net -- so every asset is blocked and the app shows
-- "couldn't load the files". Upstream issue #157, open since 2026-03-31.
--
-- ⚠️ `--class=todoist-app` IS IGNORED. Chromium app mode generates its own
-- WM class from the URL and profile, so the window reports
--     brave-app.todoist.com__-Default
-- not the class you asked for. Measured 2026-09-13. The `__.*` tail keeps the
-- rule working if the profile inside --user-data-dir is ever renamed.
--
-- ⚠️ Obsidian is matched TWO ways on purpose. Its .desktop advertises
-- StartupWMClass `md.obsidian.Obsidian`, but Electron apps commonly report a
-- plain lowercase app_id under Wayland. Matching only the .desktop value
-- risks a rule that never fires and looks like Hyprland ignoring it.
-- Collapse this to whichever one is real after checking `hyprctl clients`
-- with Obsidian open.
--
-- Deliberately NOT `silent`: these are launched to be looked at, so following
-- the window to workspace 3 is the wanted behaviour.
hl.window_rule({ name = "todoist-notes-ws",
                 match = { class = "^(brave-app\\.todoist\\.com__.*)$" },
                 workspace = "3" })
hl.window_rule({ name = "obsidian-notes-ws",
                 match = { class = "^(md\\.obsidian\\.Obsidian|obsidian)$" },
                 workspace = "3" })

hl.window_rule({ name = "pip-float", match = { title = "^(Picture-in-Picture)$" }, float = true })
hl.window_rule({ name = "pip-pin",   match = { title = "^(Picture-in-Picture)$" }, pin = true })
hl.window_rule({ name = "util-float",
    match = { class = "^(pavucontrol|wiremix|nm-connection-editor|blueman-manager)$" }, float = true })
hl.window_rule({ name = "filedlg-float",
    match = { title = "^(Open File|Save File|Save As|Open Folder)$" }, float = true })

-- TeamSpeak 3: 0.85 to match ghostty's background-opacity.
--
-- NOT the same mechanism, despite the matching number. Ghostty applies alpha
-- itself, to its own background only, so glyphs stay fully opaque. TS3 is a Qt5
-- XWayland client with no such setting, so the only lever is the compositor,
-- and that alphas the ENTIRE surface -- text, icons and avatars included. This
-- is exactly the whole-window dimming that decoration:active_opacity was left
-- at 1.0 to avoid; it is scoped to this one class deliberately.
--
-- Both values given so the window does not change opacity on focus.
-- 0.56 Lua: `opacity` is ONE STRING holding the conf-style value. A table
-- {0.85, 0.85} is rejected ("string type requires a string") and there is no
-- opacity_inactive field -- verified with --verify-config on this build.
--
-- blur { enabled = false } stands, so what shows through is the raw wallpaper
-- or window behind, not a frosted blur.
hl.window_rule({ name = "ts3-opacity", match = { class = "^(TeamSpeak 3)$" },
    opacity = "0.85 0.85" })
