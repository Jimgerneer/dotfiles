{{- $p := index .palettes .theme -}}
# STAGING COPY. The live file is /etc/greetd/config.toml -- chezmoi manages
# $HOME only, so install with:
#     sudo install -Dm644 ~/.config/greetd/config.toml /etc/greetd/config.toml
#
# Active palette: {{ .theme }}
#
# ── NO AUTOLOGIN, and that is deliberate ─────────────────────────────────────
# An earlier draft used [initial_session] to go straight to the desktop after
# the LUKS passphrase. Reversed 2026-08-25 because it interacts badly with the
# gnome-keyring that the Wayland stack pulls in:
#
#   normal login  -> PAM unlocks the login keyring with your password. One
#                    password unlocks the session AND the keyring.
#   autologin     -> nothing for PAM to unlock with, so the keyring prompts
#                    separately on every boot.
#
# Autologin therefore does not remove a password prompt, it moves it and makes
# it uglier -- while forcing a choice between a plaintext keyring and a second
# prompt. A single greetd login is strictly better.
#
# It also keeps the session menu in front of you at every boot, which is the
# bspwm escape hatch during the Hyprland migration.

[terminal]
vt = 1

[default_session]
# regreet (GTK4) rather than tuigreet (TUI), because a TUI draws with text
# characters and therefore cannot show the wallpaper. regreet renders a real
# image and reads its colours from a GTK theme.
#
# It needs a compositor to run inside; `cage` is the minimal one.
#   -s  allow VT switching -- keep this, it is the way to a TTY if the
#       greeter itself misbehaves.
#   -d  no client-side decorations, so there is no title bar on the greeter.
#   Wrapped in sh so stderr can be dropped: cage logs wlroots INFO (GPU
#   enumeration, EGL/GLES2 extension dumps, DRM connector scan) straight to
#   /dev/tty1, which flashes on screen at every logout. It is NOT the -d flag
#   (-d is decorations, -D is debug) and a StandardError= drop-in on
#   greetd.service does NOT catch it -- greetd gives the greeter its own VT,
#   so the redirect has to be here. To get logs back: 2>>/tmp/greeter.log
#   Kept as a LOG rather than /dev/null: tmpfs, cleared each boot, costs
#   nothing, and leaves the greeter diagnosable. Read /tmp/greeter.log.
#   See phase-4-desktop.md "Greeter console spam".
command = "sh -c 'exec cage -s -d -- regreet >/tmp/greeter.log 2>&1'"
user = "greeter"

[general]
clear_password = true
