{{- $p := index .palettes .theme -}}
/* GENERATED by chezmoi from .chezmoidata/palettes.toml -- do not hand-edit.
 * Active palette: {{ .theme }}
 *
 * Same seam as the launcher: confirm.rasi, message.rasi and column_circle.rasi
 * all import this and define no colours of their own.
 *
 * The 8-digit values are #RRGGBBAA -- rofi's rasi takes an alpha byte, and the
 * original theme used it deliberately, so the alphas are preserved rather than
 * flattened to opaque.
 *
 * Previously: @import "nordic.rasi", still on disk if you want it back.
 */
* {
    background:      {{ $p.bg1 }};
    background-alt:  {{ $p.bg2 }}ff;
    foreground:      {{ $p.fg1 }}cc;
    border:          {{ $p.bg3 }}ff;
    border-alt:      {{ $p.accent }}ff;
    selected:        {{ $p.accent }};
    urgent:          {{ $p.red }}ff;
}
