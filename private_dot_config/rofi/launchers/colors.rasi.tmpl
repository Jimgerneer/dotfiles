{{- $p := index .palettes .theme -}}
/* GENERATED by chezmoi from .chezmoidata/palettes.toml -- do not hand-edit.
 * Active palette: {{ .theme }}
 *
 * This is the seam the upstream rofi config already provided: every layout
 * (grid.rasi, blurry_full.rasi) imports this file and nothing else defines a
 * colour. So templating this one file re-themes the whole launcher, and the
 * layouts stay untouched third-party files.
 *
 * Previously: @import "styles/black_ocean.rasi", which is still on disk if you
 * ever want the original back.
 */
* {
  accent:           {{ $p.accent }};
  background:       {{ $p.bg1 }};
  background-light: {{ $p.bg2 }};
  foreground:       {{ $p.fg1 }};
  on:               {{ $p.green }};
  off:              {{ $p.red }};
}
