{{- $p := index .palettes .theme -}}
// Waybar — tinos.  Colours live in style.css (templated from the palette).
//
// Layout is deliberately sparse. On a 5120x1440 panel a busy bar becomes a
// stripe of noise you stop reading; the point is that anything shown here is
// something worth glancing at.
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  // Small side margins so the bar reads as a element, not a screen edge.
  "margin-top": 4,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["hyprland/workspaces", "hyprland/submap"],
  "modules-center": ["hyprland/window"],
  "modules-right":  ["custom/audioout", "wireplumber", "custom/mic",
                     "cpu", "memory", "temperature", "tray", "clock"],

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 90,
    "separate-outputs": true
  },

  // ── Which output is live, and one click to swap ──────────────────────────
  // Reuses ~/.local/bin/audio-out from Phase 1 rather than reimplementing the
  // logic. That script hardware-mutes the unused stage, which is the only way
  // this card actually stops mirroring analog onto S/PDIF.
  "custom/audioout": {
    "exec": "{{ .chezmoi.homeDir }}/.local/bin/audio-out status 2>/dev/null | head -1 | awk '{print $1}'",
    "interval": 5,
    "format": "{}",
    "on-click": "{{ .chezmoi.homeDir }}/.local/bin/audio-out toggle",
    "tooltip": true
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "muted",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
    "max-volume": 100
  },

  // Mic state matters here -- there is a whole DSP chain behind it, and being
  // live when you think you are muted is the expensive mistake.
  "custom/mic": {
    "exec": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && echo \"mic off\" || echo \"mic on\"'",
    "interval": 2,
    "format": "{}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },

  "cpu":    { "format": "cpu {usage}%", "interval": 5 },
  "memory": { "format": "mem {percentage}%", "interval": 10 },

  "temperature": {
    "critical-threshold": 85,
    "format": "{temperatureC}°C",
    "interval": 10
  },

  "tray": { "icon-size": 18, "spacing": 8 },

  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": { "mode": "month" }
  }
}
