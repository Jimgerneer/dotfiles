{{- $p := index .palettes .theme -}}
/* GENERATED by chezmoi from .chezmoidata/palettes.toml -- do not hand-edit.
 * Active palette: {{ .theme }}
 *
 * The bar sits at the top of a 5120x1440 panel, above whatever you are looking
 * at -- including a Resolve viewer. So the ground stays neutral and colour is
 * used only to mean something: accent = focused, red = needs attention.
 * See phase-4-desktop.md, "neutral core, coloured periphery".
 */

* {
  font-family: "Adwaita Sans", "Symbols Nerd Font", sans-serif;
  font-size: 13px;
  border: none;
  border-radius: 0;
  min-height: 0;
}

window#waybar {
  background-color: alpha({{ $p.bg1 }}, 0.92);
  color: {{ $p.fg1 }};
  border: 1px solid {{ $p.bg3 }};
  border-radius: 8px;
}

/* Every module gets the same breathing room, so the bar reads as one object. */
#workspaces, #submap, #window, #custom-audioout, #wireplumber,
#custom-mic, #cpu, #memory, #temperature, #tray, #clock {
  padding: 0 11px;
  background-color: transparent;
}

#workspaces button {
  padding: 0 9px;
  color: {{ $p.fg2 }};
  border-bottom: 2px solid transparent;
}
#workspaces button.active {
  color: {{ $p.accent }};
  border-bottom: 2px solid {{ $p.accent }};
}
#workspaces button.urgent {
  color: {{ $p.bg0 }};
  background-color: {{ $p.red }};
  border-radius: 5px;
}
#workspaces button:hover {
  color: {{ $p.fg0 }};
  background-color: {{ $p.bg2 }};
}

/* Centre title: deliberately quiet. It is context, not information. */
#window { color: {{ $p.fg2 }}; }
window#waybar.empty #window { background-color: transparent; }

#clock  { color: {{ $p.fg0 }}; font-weight: 600; }
#custom-audioout { color: {{ $p.accent }}; }
#wireplumber     { color: {{ $p.fg1 }}; }
#wireplumber.muted { color: {{ $p.fg2 }}; }

/* Mic live is the state worth noticing -- so it is the loud one, not the
 * muted one. Being hot when you think you are muted is the costly mistake. */
#custom-mic { color: {{ $p.green }}; }

#cpu, #memory { color: {{ $p.fg2 }}; }
#temperature  { color: {{ $p.fg2 }}; }
#temperature.critical {
  color: {{ $p.bg0 }};
  background-color: {{ $p.red }};
  border-radius: 5px;
}

#tray > .passive        { -gtk-icon-effect: dim; }
#tray > .needs-attention { -gtk-icon-effect: highlight; }

tooltip {
  background-color: {{ $p.bg2 }};
  border: 1px solid {{ $p.bg3 }};
  border-radius: 7px;
}
tooltip label { color: {{ $p.fg1 }}; }
