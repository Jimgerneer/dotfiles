{{- $p := index .palettes .theme -}}
# GENERATED by chezmoi from .chezmoidata/palettes.toml -- do not hand-edit.
# Active palette: {{ .theme }}
#
# Notifications sit ON TOP of whatever is on screen, including a Resolve
# viewer. That is the one place a saturated panel does real harm, so the
# ground here stays neutral and only the left border carries the accent.

[global]
    monitor = 0
    follow = mouse
    width = (300, 460)
    height = (0, 300)
    origin = top-right
    offset = (18, 18)
    scale = 0
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 460

    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 10
    frame_width = 2
    gap_size = 6
    separator_color = frame
    sort = yes

    font = Inter 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 24
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 6
    ignore_dbusclose = false

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "{{ $p.bg1 }}"
    foreground = "{{ $p.fg2 }}"
    frame_color = "{{ $p.bg3 }}"
    highlight = "{{ $p.blue }}"
    timeout = 4

[urgency_normal]
    background = "{{ $p.bg2 }}"
    foreground = "{{ $p.fg1 }}"
    frame_color = "{{ $p.accent }}"
    highlight = "{{ $p.accent }}"
    timeout = 8

[urgency_critical]
    background = "{{ $p.bg2 }}"
    foreground = "{{ $p.fg0 }}"
    frame_color = "{{ $p.red }}"
    highlight = "{{ $p.red }}"
    timeout = 0

# Volume / brightness OSD: replace in place rather than stacking a column of
# them while the volume knob is turning.
[osd]
    appname = "osd"
    set_stack_tag = "osd"
    format = "<b>%s</b>\n%b"
    timeout = 2
