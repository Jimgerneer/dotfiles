[Unit]
Description=Push the tinos clipboard to the work Mac
Documentation=file://%h/Documents/arch-rebuild/phase-6-remote-mac.md
# Dies with the graphical session -- wl-paste needs a Wayland display, and there
# is nothing to watch without one.
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Without these, a Mac that is switched off turns Restart=always into a hot loop
# that fills the journal. Five tries a minute, then stop, is enough to ride out a
# Mac reboot without spamming.
# ⚠️ These are [Unit] keys, NOT [Service]. Put them in [Service] and systemd
# ignores them silently -- `systemd-analyze verify` is the only thing that says so.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/clip-push-mac
Restart=always
RestartSec=3

# ⚠️ NO [Install] SECTION, ON PURPOSE -- started by `work --start` and stopped
# by `work --end`, not by logging in. It pushes the tinos clipboard to the Mac
# CONTINUOUSLY, and the Mac may keep clipboard history on disk, so running it
# outside work hours is a standing exposure for no benefit. See the SECURITY
# section of phase-6-remote-mac.md.
#
# PartOf=graphical-session.target above still stops it when the session ends.
