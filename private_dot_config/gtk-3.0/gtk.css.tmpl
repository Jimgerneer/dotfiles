{{- $p := index .palettes .theme -}}
/* GENERATED by chezmoi from .chezmoidata/palettes.toml -- do not hand-edit.
 * Active palette: {{ .theme }}
 *
 * HOW THIS WORKS, AND ITS LIMIT.
 * Adwaita-dark's stylesheet is written against named colours (@theme_bg_color
 * and friends). ~/.config/gtk-3.0/gtk.css loads AFTER the theme, so redefining
 * those names here re-tints Adwaita from the inside. That covers the surfaces
 * you actually look at in Thunar -- window, sidebar, list, selection, headerbar.
 *
 * It is NOT a full recolour. Adwaita hardcodes some colours (a few icons,
 * gradients and shadow stops) that no @define-color can reach, so a handful of
 * pixels stay Adwaita-grey. Getting past that means generating a whole GTK3
 * theme, which is a much bigger, more fragile dependency for a small return.
 * The pragmatic line is: named colours here, and accept the remainder.
 *
 * GTK4/libadwaita ignores nearly all of this -- another reason Thunar (GTK3)
 * stayed as the file manager. See phase-4-desktop.md.
 */

@define-color theme_bg_color            {{ $p.bg1 }};
@define-color theme_base_color          {{ $p.bg0 }};
@define-color theme_fg_color            {{ $p.fg1 }};
@define-color theme_text_color          {{ $p.fg1 }};
@define-color theme_selected_bg_color   {{ $p.accent }};
@define-color theme_selected_fg_color   {{ $p.bg0 }};
@define-color insensitive_bg_color      {{ $p.bg2 }};
@define-color insensitive_fg_color      {{ $p.fg2 }};
@define-color insensitive_base_color    {{ $p.bg1 }};
@define-color borders                   {{ $p.bg3 }};
@define-color unfocused_borders         {{ $p.bg3 }};
@define-color theme_unfocused_bg_color  {{ $p.bg1 }};
@define-color theme_unfocused_base_color {{ $p.bg0 }};
@define-color theme_unfocused_fg_color  {{ $p.fg2 }};
@define-color theme_unfocused_text_color {{ $p.fg1 }};
@define-color theme_unfocused_selected_bg_color {{ $p.bg3 }};
@define-color theme_unfocused_selected_fg_color {{ $p.fg0 }};
@define-color warning_color             {{ $p.yellow }};
@define-color error_color               {{ $p.red }};
@define-color success_color             {{ $p.green }};
@define-color link_color                {{ $p.blue }};
@define-color visited_link_color        {{ $p.magenta }};
@define-color content_view_bg           {{ $p.bg0 }};
@define-color wm_bg                     {{ $p.bg2 }};
@define-color headerbar_bg_color        {{ $p.bg2 }};

/* Thunar: flatten the headerbar/toolbar gradients Adwaita draws, which
 * otherwise read as grey stripes over the re-tinted ground. */
headerbar,
.titlebar,
toolbar {
  background-image: none;
  background-color: {{ $p.bg2 }};
  color: {{ $p.fg1 }};
  border-color: {{ $p.bg3 }};
}

/* Sidebar (shortcuts pane) one step back from the file list, so the list
 * itself stays the darkest, quietest surface on screen. */
.sidebar,
placessidebar,
placessidebar list {
  background-color: {{ $p.bg1 }};
  color: {{ $p.fg1 }};
}

/* The file list -- this sits next to image thumbnails, so it stays neutral
 * ground with no accent tint. */
.view,
treeview.view,
iconview {
  background-color: {{ $p.bg0 }};
  color: {{ $p.fg1 }};
}
treeview.view:selected,
iconview:selected,
.view:selected {
  background-color: {{ $p.accent }};
  color: {{ $p.bg0 }};
}

/* Path bar buttons: no gradient, accent only on the current segment. */
button {
  background-image: none;
  background-color: {{ $p.bg2 }};
  color: {{ $p.fg1 }};
  border-color: {{ $p.bg3 }};
}
button:hover      { background-color: {{ $p.bg3 }}; }
button:checked,
button:active     { background-color: {{ $p.bg3 }}; color: {{ $p.accent }}; }
button:disabled   { color: {{ $p.fg2 }}; }

entry {
  background-color: {{ $p.bg0 }};
  color: {{ $p.fg1 }};
  border-color: {{ $p.bg3 }};
}
entry:focus { border-color: {{ $p.accent }}; }

menu, .menu, popover, popover.background {
  background-color: {{ $p.bg2 }};
  color: {{ $p.fg1 }};
  border: 1px solid {{ $p.bg3 }};
}
menuitem:hover, .menu menuitem:hover {
  background-color: {{ $p.accent }};
  color: {{ $p.bg0 }};
}

scrollbar slider          { background-color: {{ $p.bg4 }}; }
scrollbar slider:hover    { background-color: {{ $p.fg2 }}; }
