{{- $p := index .palettes .theme -}}
/* GENERATED by chezmoi -- active palette: {{ .theme }}
 *
 * libadwaita deliberately ignores gtk-theme-name and most of the GTK3 named
 * colours. Since 1.6 it does honour a handful of @define-color overrides, so
 * this makes GTK4 dialogs land in roughly the right place rather than sitting
 * at stock Adwaita. Do not expect it to match Thunar exactly -- it will not,
 * and chasing that is not worth the effort. See phase-4-desktop.md.
 */
@define-color window_bg_color     {{ $p.bg1 }};
@define-color window_fg_color     {{ $p.fg1 }};
@define-color view_bg_color       {{ $p.bg0 }};
@define-color view_fg_color       {{ $p.fg1 }};
@define-color headerbar_bg_color  {{ $p.bg2 }};
@define-color headerbar_fg_color  {{ $p.fg1 }};
@define-color popover_bg_color    {{ $p.bg2 }};
@define-color popover_fg_color    {{ $p.fg1 }};
@define-color card_bg_color       {{ $p.bg2 }};
@define-color card_fg_color       {{ $p.fg1 }};
@define-color dialog_bg_color     {{ $p.bg2 }};
@define-color dialog_fg_color     {{ $p.fg1 }};
@define-color accent_bg_color     {{ $p.accent }};
@define-color accent_fg_color     {{ $p.bg0 }};
@define-color accent_color        {{ $p.accent }};
@define-color destructive_bg_color {{ $p.red }};
@define-color success_color       {{ $p.green }};
@define-color warning_color       {{ $p.yellow }};
@define-color error_color         {{ $p.red }};
