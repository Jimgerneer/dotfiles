#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Wire .githooks/ into this repo's git config.
#
# core.hooksPath lives in .git/config, which is NOT versioned. Cloning brings
# the hook FILE down and leaves it connected to nothing -- silently, and failing
# OPEN: no scanning, and no indication you have none. On a public repo that is
# the worst possible failure direction.
#
# `run_once_`, per chezmoi's own guidance: run_once_ is for one-time setup, and
# plain `run_` is "generally discouraged since it breaks the declarative model".
# An earlier version of this was a plain run_ script so it would self-heal; that
# was the wrong instrument. It also left `chezmoi status` permanently showing a
# pending entry, which erodes status as a glance-check.
#
# run_once_ state is keyed on the SHA256 of the rendered CONTENT (scriptState
# bucket), not on the path -- verified, a move with identical content does not
# re-fire it. So on a fresh machine, where the state db is empty, this runs.
#
# ⚠️ The gap run_once_ leaves: the state db lives at
# ~/.config/chezmoi/chezmoistate.boltdb, OUTSIDE the source repo. Deleting and
# re-cloning the repo on a machine that has already run this will NOT re-run it,
# and the new clone would have no hooksPath. That case is covered separately by
# hooks.apply.pre in .chezmoi.toml.tmpl, which runs on every apply. Belt and
# braces, each using the mechanism actually designed for its job.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

SRC={{ .chezmoi.sourceDir | quote }}

# Only meaningful if the source dir is a git checkout; a chezmoi source tree does
# not have to be one.
[ -d "$SRC/.git" ] || exit 0
[ -f "$SRC/.githooks/pre-commit" ] || exit 0

current=$(git -C "$SRC" config --get core.hooksPath 2>/dev/null || true)
if [ "$current" != ".githooks" ]; then
    git -C "$SRC" config core.hooksPath .githooks
    echo "git hooks: core.hooksPath set to .githooks (was ${current:-unset})"
fi
