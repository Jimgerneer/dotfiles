#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# Link satchel (private Claude skills/agents/CLAUDE.md, cloned by
# .chezmoiexternal.toml.tmpl) into ~/.claude for this machine's profiles.
#
# run_onchange_ re-fires when the rendered content changes. The lines below
# fold in the profiles and the current list of satchel items, so adding,
# removing or renaming one, or changing profiles, relinks on the next apply.
# Pure content edits need no relink: the links already point at the files.
#
{{- $profiles := index . "satchelProfiles" | default "" }}
# profiles: {{ $profiles }}
# items: {{ joinPath .chezmoi.homeDir "Code/satchel/*/skills/*" | glob | join " " | sha256sum }}
#        {{ joinPath .chezmoi.homeDir "Code/satchel/*/agents/*" | glob | join " " | sha256sum }}
#        {{ joinPath .chezmoi.homeDir "Code/satchel/*/CLAUDE.md" | glob | join " " | sha256sum }}
# ─────────────────────────────────────────────────────────────────────────────
set -eu

link="$HOME/Code/satchel/bin/satchel-link"
if [ ! -x "$link" ]; then
    echo "satchel: $link missing (clone failed?); skipping" >&2
    exit 0
fi
profiles={{ $profiles | quote }}
if [ -z "$profiles" ]; then
    echo "satchel: no satchelProfiles in chezmoi.toml yet; run 'chezmoi init' to choose them" >&2
    exit 0
fi
# shellcheck disable=SC2086  # word-splitting the profile list is the point
exec "$link" $profiles
