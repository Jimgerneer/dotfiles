{{/* Linux-only. Guarded in-script rather than via .chezmoiignore: chezmoi
     skips a script that renders to zero bytes (verified), the guard cannot
     drift away from the file it guards, and it survives renames -- a
     .chezmoiignore entry matches the TARGET NAME, which silently stopped
     matching when these moved into .chezmoiscripts/. Targets here are
     Linux-only: /etc/vtrgb, /usr/share/plymouth, ~/.ts3client, gtk-3.0. */ -}}
{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Push the newly-applied palette into everything already running.
#
# This is a run_onchange_ script, so chezmoi re-runs it exactly when its own
# rendered content changes. The palette values below are what make that true:
# switch palettes and this text differs, so it fires. Re-apply without changing
# the palette and it does not. That is the whole mechanism -- no timestamps, no
# state file.
#
# palette:  {{ .theme }}
{{- $p := index .palettes .theme }}
# ground:   {{ $p.bg1 }}
# accent:   {{ $p.accent }}
# ansi:     {{ range $i, $c := $p.ansi }}{{ $c }} {{ end }}

set -uo pipefail
say() { printf '  %-10s %s\n' "$1" "$2"; }
echo "reload-theme: palette is now {{ .theme }}"

# --- ghostty: SIGUSR2 is its config-reload signal ---------------------------
if pgrep -x ghostty >/dev/null 2>&1; then
    pkill -USR2 -x ghostty && say ghostty "reloaded in place"
else
    say ghostty "not running"
fi

# --- GTK3: no signal needed. GTK file-monitors ~/.config/gtk-3.0/gtk.css and
#     restyles live, so Thunar recolours without being restarted. -------------
if pgrep -x Thunar >/dev/null 2>&1; then
    say thunar "live (GTK watches gtk.css)"
fi

# --- noctalia -----------------------------------------------------------------
#     Bar, launcher, notifications, clipboard and OSD in one process. Replaced
#     waybar + rofi + dunst + hyprpaper on 2026-08-28.
#
#     The palette reaches it as a RENDERED FILE -- .config/noctalia/palettes/
#     active.json, written by this repo. Noctalia also ships its own template
#     engine with 55 community templates covering ghostty, zellij, tmux, bat
#     and more, all of which chezmoi ALREADY renders from this same palette.
#     Two engines writing one file is exactly the version skew palettes.toml
#     warns about, so `noctalia msg templates-apply` stays OFF and chezmoi
#     remains the only writer. Do not enable it.
#
#     Why set the scheme on every run rather than once: Noctalia owns its
#     settings.toml and rewrites it from memory, discarding outside edits
#     (verified 2026-08-28). color-scheme-set is idempotent, so re-asserting
#     the selection here is cheap and survives that.
if pgrep -x noctalia >/dev/null 2>&1; then
    noctalia msg color-scheme-set custom active >/dev/null 2>&1 \
        && say noctalia "palette -> custom/active"
    noctalia msg config-reload >/dev/null 2>&1 \
        && say noctalia "reloaded in place"
else
    say noctalia "not running"
fi

# --- TeamSpeak 3: Qt reads the .qss once at startup. Nothing to signal. ------
if pgrep -f 'ts3client' >/dev/null 2>&1; then
    say teamspeak "RESTART REQUIRED -- Qt loads the skin only at startup"
fi

# --- Anything already-open that cannot be told: say so plainly rather than
#     leaving you wondering why one window did not change. -------------------
cat <<'NOTE'

  Not reloadable in place -- these pick the palette up on next start:
    TeamSpeak 3   (Qt loads .qss at startup; pick "tinos" once under
                   Options -> Design -> Skin, then it stays selected)
    Brave         (theme is set inside the browser, not by this repo)
    GTK4 apps     (libadwaita caches its stylesheet per-process)
NOTE
{{ end }}