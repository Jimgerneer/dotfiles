# ---------------------------------------------------------------------------
# tinos-only (the Arch desktop). Phase 1 audio: every one of these names
# hardware that exists ONLY on tinos -- an ASUS Xonar Essence STX and a RODE
# AI-1. Elsewhere they would create sinks for a sound card that is not there,
# a filter chain pinned to a missing capture device, and a systemd unit that
# cannot succeed.
#   ~/Documents/arch-rebuild/phase-1-audio-map.md   -- what these do
#   ~/Documents/arch-rebuild/phase-1-audio.md       -- why they are as they are
# Also: the DaVinci Resolve launcher + .desktop override (paths under
# /opt/resolve), and sxhkdrc (bspwm bindings calling the audio scripts).
{{ if ne .chezmoi.hostname "tinos" }}
.config/pipewire
.config/wireplumber
.config/systemd/user/xonar-spdif.service
.config/sxhkd
.config/fish/conf.d/restic.fish
.config/restic
.local/bin/audio-out
.local/bin/mic-level
.local/bin/mic-test
.local/bin/resolve
.local/share/applications/DaVinciResolve.desktop

# Added 2026-08-26 after these broke fish on the work Mac. None of them are
# dotfiles -- they are ARTEFACTS generated by tools on tinos, and shipping them
# to a machine whose tooling differs is actively harmful:
#
#   z.fish                       written by the fisher plugin jethrokuan/z.
#                                Fisher is NOT installed on the Mac and its
#                                plugin list is a different file (fish_plugins,
#                                holding only nvm.fish). Deploying the half that
#                                CALLS __z_complete without the functions half
#                                that DEFINES it made every fish start -- and so
#                                every `ssh mac` -- print an error.
#   fish_frozen_*.fish           written by fish itself when upgrading to >= 4.3
#                                to migrate universal variables. tinos runs fish
#                                4.8; the Mac runs 3.7.1, where these mean
#                                nothing.
#   fish-ssh-agent_init.fish     a deliberate no-op whose entire content is about
#                                the systemd ssh-agent on tinos.
#
# Reproduce plugins from the plugin LIST (fishfile / fish_plugins) and a fisher
# run -- never by copying what fisher generated.
.config/fish/conf.d/z.fish
.config/fish/conf.d/fish_frozen_key_bindings.fish
.config/fish/conf.d/fish_frozen_theme.fish
.config/fish/conf.d/fish-ssh-agent_init.fish

# `work` attaches to a zellij session on the work Mac over ssh. On the Mac
# itself it would be pointing at itself, and the `mac` ssh host does not exist
# there anyway.
.config/fish/functions/work.fish
{{ end }}

# ---------------------------------------------------------------------------
# Linux-only theming. The palette itself (.chezmoidata/palettes.toml) IS shared
# -- ghostty and kitty read it on every machine, which is the point of having
# one theme. These four are the Linux-desktop-specific consumers:
#   dunst    -- the notification daemon; macOS has its own
#   gtk-3.0  -- Thunar
#   gtk-4.0  -- GTK4 dialogs
#   rofi     -- launcher + power menu (its powermenu.sh calls bspc/systemctl)
#   hypr     -- Hyprland, hyprpaper, hyprlock, hypridle
# The TeamSpeak re-tint script guards itself at runtime (it exits quietly when
# DarkenTS is not installed), so it does not need to be listed here.
{{ if ne .chezmoi.os "linux" }}
.config/dunst
.config/gtk-3.0
.config/gtk-4.0
.config/rofi
.config/hypr
.config/waybar

# Added 2026-08-26. The work Mac tracks this repo too, so anything that assumes
# a Linux desktop has to be excluded explicitly or it lands there as clutter --
# or worse, as a unit file that looks like it should be doing something.
#
#   greetd         the login greeter; there is no greetd on macOS
#   systemd        macOS has launchd. Nothing under here can run there.
#                  (xonar-spdif.service is ALSO in the tinos-only block above,
#                   because it is hardware-specific even among Linux machines.)
#   environment.d  read by the systemd user manager; meaningless without one
#   dbus-1         the D-Bus session-service override for gnome-keyring
#   clip-*-mac     the clipboard bridge. wl-paste/wl-copy are Wayland tools, and
#                  the direction is tinos -> Mac, so on the Mac they are both
#                  non-functional and backwards.
.config/greetd
.config/systemd
.config/environment.d
.local/share/dbus-1
.local/bin/clip-push-mac
.local/bin/clip-pull-mac
#   mac-worksession  drives the Mac FROM tinos over ssh. On the Mac it would be
#                    a script that ssh's to itself.
.local/bin/mac-worksession
#   work-indicator   a waybar module; there is no waybar on macOS
.local/bin/work-indicator
#   ts3-ptt-daemon   reads /dev/input and talks to a local TS3; Linux-only
.local/bin/ts3-ptt-daemon
{{ end }}

# ---------------------------------------------------------------------------
# Mac-only. Added 2026-08-27. macOS launchd + the Ghostty login session; there
# is no ~/Library on Linux and nothing here can run there.
#   Library/LaunchAgents/local.code-session.plist  opens Ghostty at login
#   .local/bin/mac-code-session                    what that plist runs
# Both create the `Code` zellij session in the Aqua security session, which is
# the only way it gets login-keychain access -- see phase-6-remote-mac.md.
{{ if eq .chezmoi.hostname "tinos" }}
Library
.local/bin/mac-code-session
{{ end }}

# Python bytecode. chezmoi add on ~/.local/bin once swept up the __pycache__
# for ts3-ptt-daemon; it is a build artifact of the deployed script, never
# source, and it landed in a PUBLIC repo. git-level .gitignore is not enough:
# chezmoi reads the source DIRECTORY, not git, so it must be ignored here too.
.local/bin/__pycache__
